{
  "name": "galaxy-campaign-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.atlas.config.ts",
    "dev:gm": "node scripts/ensure-dev.mjs",
    "build": "npm run test:atlas && tsc -p tsconfig.atlas.json && vite build --config vite.atlas.config.ts && node scripts/check-atlas-dist.mjs",
    "build:gm": "tsc -b && vite build --outDir dist-gm",
    "test:atlas": "node --test tests/atlas.test.ts",
    "atlas:init": "node scripts/atlas.ts init",
    "atlas:import": "node scripts/atlas.ts import",
    "atlas:publish": "node scripts/atlas.ts publish",
    "lint": "oxlint",
    "preview": "vite preview --config vite.atlas.config.ts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-zoom-pan-pinch": "^4.0.3",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
